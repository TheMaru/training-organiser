package views

templ Home() {
	@Base("Training Organiser") {
		<div class="bg-white p-6 rounded-lg shadow-md">
			<h1 class="text-2xl font-bold mb-4">Welcome to Training Organiser</h1>
			<p class="text-gray-600">This is a simple application to organize trainings.</p>
			<div class="mt-4">
				<button hx-get="/health" hx-swap="outerHTML" class="bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
					Check Health
				</button>
			</div>
		</div>
	}
}
